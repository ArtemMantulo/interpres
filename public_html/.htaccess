# ============================================================
#  Site root  —  Immersive Solutions site (static, built from site/)
#  /demo      —  Gaussian Splats Viewer (interpres.live)
# ============================================================

# --- MIME types for ES modules ---------------------------------
<IfModule mod_mime.c>
    AddType text/javascript .js .mjs
    AddType model/gltf-binary .glb
    AddType application/octet-stream .ksplat
    AddType image/webp .webp
    AddType video/mp4 .mp4
</IfModule>

# NOTE: Cross-Origin-Embedder-Policy is intentionally NOT set here.
# The viewer needs it (see demo/.htaccess), but require-corp at the
# root would block Google Fonts and other third-party assets used
# by the site.

DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # --- Old marketing-site (React) URLs -> new pages ---------------
    RewriteRule ^solutions/digital-twin/?$ /digital-twin.html [R=301,L]
    RewriteRule ^solutions/web-catalog/?$  /digital-twin.html [R=301,L]
    RewriteRule ^cases/breig/?$            /case-breig.html   [R=301,L]
    RewriteRule ^cases/magnum/?$           /case-magnum.html  [R=301,L]
    RewriteRule ^cases/altyn-adam/?$       /case-altyn.html   [R=301,L]
    RewriteRule ^cases/?$                  /cases.html        [R=301,L]

    # --- Bridge for the legacy viewer -------------------------------
    # The viewer bundles absolute paths (/assets/*.ksplat, /src/...),
    # which after the move to /demo would miss at the root. Anything
    # not found at the root is served from /demo instead. This also
    # keeps old links such as /src/breig_elysium_hdri/index.html alive.
    RewriteCond %{REQUEST_URI} !^/demo/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^assets/(.+)$ /demo/assets/$1 [L]

    RewriteCond %{REQUEST_URI} !^/demo/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^src/(.+)$ /demo/src/$1 [L]

    RewriteCond %{REQUEST_URI} !^/demo/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^scene_assets/(.+)$ /demo/scene_assets/$1 [L]
</IfModule>

# --- Caching ---------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/javascript "access plus 1 week"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType video/mp4 "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
